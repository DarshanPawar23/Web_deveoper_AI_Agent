{
  "name": "engg_team",
  "agents": [
    "senior_software_solution_archi",
    "senior_backend_software_engine",
    "senior_frontend_engineer_and_u",
    "senior_software_code_reviewer_",
    "senior_software_test_engineer_"
  ],
  "tasks": [
    {
      "name": "analyze_requirements_and_specifications",
      "description": "Analyze the user's software project {project} request. Extract and validate all functional requirements, non-functional requirements, business rules, user roles, technical constraints, and expected deliverables.",
      "expected_output": "A validated requirements document mapping out user roles, functional specifications, non-functional constraints, and business logic rules.",
      "output_file": "docs/requirements_spec.md",
      "agent": "senior_software_solution_archi"
    },
    {
      "name": "design_system_architecture_and_data_models",
      "description": "Select the optimal software architecture pattern and design the system data models. Define the complete database schema, entity relationships, and technical stack specifications based on the requirements.",
      "expected_output": "Comprehensive database schema design, system architecture blueprints, and entity relationship diagrams.",
      "output_file": "docs/architecture_blueprint.md",
      "agent": "senior_software_solution_archi"
    },
    {
      "name": "define_api_contracts_and_routing_structures",
      "description": "Design all RESTful API contracts, detailed endpoint specifications, request/response payloads, validation rules, error handling workflows, folder structure conventions, and the global authentication strategy.",
      "expected_output": "Complete OpenAPI/Swagger specifications, folder structure blueprint, error matrix, and application security guidelines.",
      "output_file": "docs/api_contract.md",
      "agent": "senior_software_solution_archi"
    },

    {
      "name": "develop_backend_models_and_repositories",
      "description": "Implement the backend data layer. Create database models, schemas, migrations, and repositories for data access following the approved architecture blueprint. Create and update source files using WriteFileTool and UpdateFileTool.",
      "expected_output": "Functional backend source code.",
      "agent": "senior_backend_software_engine"
    },
    {
      "name": "develop_backend_services_and_business_logic",
      "description": "Implement backend services, business logic, and transactions. Create and update source files using WriteFileTool and UpdateFileTool.",
      "expected_output": "Functional backend services.",
      "agent": "senior_backend_software_engine"
    },
    {
      "name": "develop_backend_controllers_and_routes",
      "description": "Implement controllers, routes, middleware, validation, configuration, and REST APIs. Create and update source files using WriteFileTool and UpdateFileTool.",
      "expected_output": "Functional backend API.",
      "agent": "senior_backend_software_engine"
    },

    {
      "name": "review_backend_codebase",
      "description": "Review the generated backend code for architecture, security, code quality, SOLID, DRY, validation, dependency health, and best practices.",
      "expected_output": "Backend review report.",
      "output_file": "docs/backend_review_report.md",
      "agent": "senior_software_code_reviewer_"
    },

    {
      "name": "conditional_backend_refinement_gate",
      "type": "ConditionalTask",
      "condition": {
        "python": "conditions.backend_conditions.should_retry_backend"
      },
      "description": "Fix backend issues found during review.",
      "expected_output": "Updated backend source code.",
      "agent": "senior_backend_software_engine"
    },

    {
      "name": "develop_frontend_components_and_layouts",
      "description": "Build layouts, reusable components, responsive UI, and styling. Create and update files using WriteFileTool and UpdateFileTool.",
      "expected_output": "Frontend components.",
      "agent": "senior_frontend_engineer_and_u"
    },

    {
      "name": "develop_frontend_pages_and_state",
      "description": "Implement pages, routing, contexts, protected routes, and state management using WriteFileTool and UpdateFileTool.",
      "expected_output": "Frontend pages.",
      "agent": "senior_frontend_engineer_and_u"
    },

    {
      "name": "integrate_frontend_authentication_and_apis",
      "description": "Integrate frontend with backend APIs, authentication, session management, and validation using WriteFileTool and UpdateFileTool.",
      "expected_output": "Integrated frontend.",
      "agent": "senior_frontend_engineer_and_u"
    },

    {
      "name": "review_full_stack_integration",
      "description": "Review frontend quality, API integration, responsiveness, environment configuration, and architecture compliance.",
      "expected_output": "Frontend review report.",
      "output_file": "docs/full_stack_review_report.md",
      "agent": "senior_software_code_reviewer_"
    },

    {
      "name": "conditional_frontend_refinement_gate",
      "type": "ConditionalTask",
      "condition": {
        "python": "conditions.frontend_conditions.should_retry_frontend"
      },
      "description": "Fix frontend issues found during review.",
      "expected_output": "Updated frontend source code.",
      "agent": "senior_frontend_engineer_and_u"
    },

    {
      "name": "validate_and_test_integrated_application",
      "description": "Run the application, install dependencies if needed, execute unit tests, integration tests, API tests, and verify the project.",
      "expected_output": "Testing report.",
      "output_file": "docs/testing_report.md",
      "agent": "senior_software_test_engineer_"
    },

    {
      "name": "conditional_test_rework_gate",
      "type": "ConditionalTask",
      "condition": {
        "python": "conditions.testing_conditions.should_retry_testing"
      },
      "description": "Coordinate fixes when testing fails.",
      "expected_output": "Updated application after fixing test failures.",
      "agent": "senior_ai_project_manager_and_"
    },

    {
      "name": "final_project_completion_arbitration",
      "description": "Review all reports and decide whether the project is complete and production ready.",
      "expected_output": "Final delivery report.",
      "output_file": "docs/final_delivery_manifest.md",
      "agent": "senior_ai_project_manager_and_"
    }
  ],
  "process": "hierarchical",
  "manager_agent": "senior_ai_project_manager_and_",
  "manager_llm": "groq/llama-3.3-70b-versatile",
  "verbose": true,
  "memory": false,
  "planning": false,
  // "planning_llm": "groq/llama-3.3-70b-versatile",
  "cache": true,
  "max_rpm": 60,
  "inputs": {}
}
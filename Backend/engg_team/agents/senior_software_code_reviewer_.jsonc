{
  // Agent's role title — appears in prompts and logs.
  // You can use {placeholder} inputs in role, goal, or backstory.
  // Example: "role": "Senior {industry} Researcher"
  "role": "Senior Software Code Reviewer and Quality Assurance Architect",

  // Optional custom Agent subclass
  // "type": {"python": "my_project.agents.CustomAgent"},

  // The agent's primary objective
  "goal": "Analyze the Software Architecture Blueprint and all project artifacts generated by previous agents before performing any review. Inspect the complete project structure using ReadDirectoryTreeTool and thoroughly examine all relevant source code, configuration files, documentation, API specifications, database schemas, Docker files, dependency files, test files, and project resources using ReadFileTool to understand the implementation. Perform a comprehensive software engineering review of the entire project by evaluating architecture compliance, Clean Architecture, SOLID principles, DRY, KISS, separation of concerns, design patterns, modularity, maintainability, scalability, readability, naming conventions, code quality, security vulnerabilities, authentication and authorization, API consistency, database design, validation, exception handling, logging, dependency management, project structure, documentation quality, testing coverage, Docker configuration, performance optimization, and overall production readiness. Identify missing files, duplicate code, dead code, architectural violations, code smells, configuration issues, dependency problems, security risks, performance bottlenecks, maintainability concerns, integration issues, and deviations from the approved architecture. Produce a detailed, structured, and actionable Code Review Report with issue descriptions, affected modules, severity classifications (Critical, High, Medium, Low), root cause analysis, recommendations, and approval status without modifying source code, generating implementation code, or performing development tasks, focusing exclusively on review and quality assurance using the available read-only tools.",

  // Background story that shapes the agent's personality and approach
  "backstory": "You are a Senior Software Architect and Code Quality Expert responsible for ensuring that every generated project meets professional software engineering standards before testing and deployment. You never write the initial implementation or modify source code directly. Instead, you perform detailed code reviews, evaluate architecture decisions, verify coding standards, identify security risks, detect duplicate logic, analyze complexity, ensure consistency across the project, and produce structured review reports with actionable recommendations. Your expertise spans backend systems, frontend applications, databases, APIs, testing, security, maintainability, and enterprise software architecture.",

  // LLM model in provider/model format
  // Examples: "openai/gpt-4o", "anthropic/claude-sonnet-4-6", "ollama/llama3.3"
  // For custom endpoints or deployment-based providers, replace with:
  // "llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},
  // "llm": {"deployment_name": "my-deployment", "provider": "azure", "api_version": "2024-10-21"},
  "llm": "ollama/qwen2.5:3b",

  // Override LLM used specifically for tool/function calling
  // "function_calling_llm": "openai/gpt-5.4-mini",

  // Tools available to this agent
  // Built-in: "SerperDevTool", "ScrapeWebsiteTool", "FileReadTool", etc.
  // Custom: "custom:my_tool" loads from tools/my_tool.py
  "tools": ["tools:ReadDirectoryTreeTool", "tools:ReadFileTool"],

  // Optional agent-level guardrail — validates this agent's final output.
  // String guardrails are checked by an LLM and can reject/retry output.
  // Python refs must point to module-level functions/classes in trusted code.
  // "guardrail": "Only answer with information supported by retrieved evidence.",
  // "step_callback": {"python": "my_project.callbacks.on_agent_step"},
  // "guardrail_max_retries": 2,

  // Advanced agent options:
  // Docs: https://docs.crewai.com/concepts/agents
  // "reasoning": true,
  // "max_reasoning_attempts": 3,
  // "planning_config": {
  //   "reasoning_effort": "medium",
  //   "llm": {"model": "deepseek-chat", "provider": "deepseek"}
  // },
  // "multimodal": false,
  // "allow_code_execution": false,
  // "code_execution_mode": "safe",
  // "knowledge_sources": [],
  // "knowledge_config": {},
  // "inject_date": true,
  // "date_format": "%Y-%m-%d",
  // "security_config": {},

  // Agent behavior settings
  "settings": {
    // Show detailed execution logs
    "verbose": true,

    // Allow this agent to delegate tasks to other agents in the crew
    "allow_delegation": false,

    // Maximum reasoning iterations per task (prevents infinite loops)
    // "max_iter": 25,

    // Maximum tokens for agent's response generation
    // "max_tokens": null,

    // Maximum execution time in seconds
    // "max_execution_time": null,

    // Maximum LLM requests per minute (rate limiting)
    // "max_rpm": null,

    // Enable agent-level memory (persists across tasks)
    // "memory": false,

    // Cache tool results to avoid duplicate calls
    "cache": true,

    // Auto-summarize context when it exceeds the LLM's context window
    // "respect_context_window": true,

    // Maximum retries on execution errors
    // "max_retry_limit": 2,

    // Enable step-by-step planning before task execution
    "planning": true

    // Include system prompt in LLM calls
    // "use_system_prompt": true

  }
}
